# Copy to .env and fill in real values. Never commit .env.

# Google Gemini (course generation + tutor answers)
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_COURSE_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# Qdrant vector database (RAG)
QDRANT_URL=
QDRANT_API_KEY=

# Embeddings (defaults shown). "gemini" needs only GEMINI_API_KEY.
# "local" runs BAAI/bge-m3 (pip install -r requirements-local.txt, ~2.3 GB download).
# Changing provider or dimensions requires: python reingest_courses.py --recreate-collection
# EMBEDDING_PROVIDER=gemini   # gemini | local
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768    # gemini only: 768 | 1536 | 3072

# Groq: speech-to-text for spoken questions (Whisper). Free key at console.groq.com.
GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Text-to-speech uses edge-tts (no key). Defaults shown; each has a fallback voice.
# TTS_VOICE_AR=ar-EG-SalmaNeural
# TTS_VOICE_AR_FALLBACK=ar-SA-HamedNeural
# TTS_VOICE_EN=en-US-AndrewNeural
# TTS_VOICE_EN_FALLBACK=en-US-AriaNeural

# ---- Optional tuning (defaults and docs live in app/core/config.py) ----
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.64      # calibrated for gemini-embedding-001; ~0.45 for bge-m3
# RERANKER=none            # none | bge (local model; needs requirements-local.txt)
# RAG_RERANK_CANDIDATES=20
# CHUNK_STRATEGY=character # character | word (legacy)
# CHUNK_SIZE_CHARS=600
# CHUNK_OVERLAP_CHARS=120
# GENERATION_MAX_ATTEMPTS=3
# ROADMAP_MIN_STEPS_PER_SECTION=4
# LESSON_MIN_CHARS=800
